<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/onboarding_a11y_title"
        android:textColor="@color/ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/onboarding_a11y_desc"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <include
        layout="@layout/include_a11y_names"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:adjustViewBounds="true"
        android:background="@drawable/bg_onboarding_hint"
        android:clipToOutline="true"
        android:contentDescription="@string/onboarding_a11y_image_desc"
        android:cropToPadding="true"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/onboarding_a11y_installed_apps" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/onboarding_a11y_image_caption"
        android:textColor="@color/ink_soft"
        android:textSize="14sp" />

    <Button
        android:id="@+id/a11yDialogAllow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="@string/a11y_off_action"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
