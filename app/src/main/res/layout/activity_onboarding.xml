<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="32dp">

    <LinearLayout
        android:id="@+id/onboardingDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/onboardingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:textColor="@color/amber"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/onboardingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onboardingDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
            android:textColor="@color/muted"
            android:textSize="16sp" />

            <include
                android:id="@+id/onboardingA11yNames"
                layout="@layout/include_a11y_names"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/onboardingHintImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_onboarding_hint"
                android:clipToOutline="true"
                android:contentDescription="@string/onboarding_a11y_image_desc"
                android:cropToPadding="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/onboarding_a11y_installed_apps"
                android:visibility="gone" />

            <TextView
                android:id="@+id/onboardingHintCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/onboarding_a11y_image_caption"
                android:textColor="@color/ink_soft"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/onboardingAllow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="36dp"
        android:text="@string/onboarding_allow"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
