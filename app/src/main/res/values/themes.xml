<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Gyolim" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryVariant">@color/ink</item>
        <item name="colorOnPrimary">@color/card</item>
        <item name="colorSecondary">@color/amber</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="materialButtonStyle">@style/Widget.Traffic.Button</item>
    </style>

    <style name="Widget.Traffic.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/ink</item>
        <item name="android:textColor">@color/card</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="A11yConsentHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="A11yConsentBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
