<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">교통음성알림</string>
    <string name="brand_name">교통음성알림</string>
    <string name="app_feature">네이버·구글 안내를 음성으로</string>
    <string name="home_hint">🔊 교통음성알림입니다.\n평소처럼 네이버 지도나 구글 지도를 사용하시면 됩니다.\n그럼 교통정보를 제가 음성으로 알려드릴게요.</string>
    <string name="first_voice_speech">교통음성알림입니다.\n평소처럼 네이버 지도나 구글 지도를 사용하시면 됩니다.\n그럼 교통정보를 제가 음성으로 알려드릴게요.</string>
    <string name="home_empty">아직 안내를 시작한 경로가 없어요.</string>
    <string name="naver_nav_listener_label">네이버 교통 알림</string>
    <string name="google_transit_a11y_label">교통음성알림 구글 교통</string>
    <string name="google_transit_a11y_desc">Google 지도 화면에 보이는 글자(버스 번호, 도착 시간, 역·정류장, 목적지 등)와 「시작」 버튼 누름을 읽어 음성 안내를 만듭니다. 다른 앱은 읽지 않고, 화면을 조작하지 않습니다.</string>
    <string name="naver_subway_a11y_label">교통음성알림 네이버 교통</string>
    <string name="naver_subway_a11y_desc">네이버 지도 화면에 보이는 글자(버스 번호, 도착 시간, 빠른 하차·환승 칸, 역·정류장, 목적지 등)와 「안내시작」·「안내 종료」 버튼 누름을 읽어 음성 안내를 만듭니다. 다른 앱은 읽지 않고, 화면을 조작하지 않습니다.</string>
    <string name="a11y_consent_title">접근성 기능 사용 안내</string>
    <string name="a11y_consent_why_title">왜 필요한가요?</string>
    <string name="a11y_consent_why">교통음성알림은 네이버 지도·Google 지도 화면에 보이는 길안내를 읽어 빠른 하차·환승 칸, 출발 안내, 버스 도착, 환승 안내를 음성으로 알려 드립니다. 이 안내를 읽으려면 Android 접근성 기능(AccessibilityService)이 필요합니다.</string>
    <string name="a11y_consent_read_title">어떤 정보를 읽나요?</string>
    <string name="a11y_consent_read">네이버 지도와 Google 지도 화면에 보이는 글자 전체와 누른 버튼 이름(예: 버스 번호, 노선, 도착 예정 시간, 정류장·역 이름, 방면, 환승·하차 안내, 목적지 이름, 안내시작·종료 버튼)을 읽습니다. 다른 앱의 화면은 읽지 않으며, 화면을 대신 누르거나 입력하지 않습니다.</string>
    <string name="a11y_consent_use_title">어디에 쓰나요?</string>
    <string name="a11y_consent_use">기기 안에서 음성 안내 문장을 만들고, 최근 경로(목적지 이름)를 기기에 저장하는 데만 씁니다.</string>
    <string name="a11y_consent_send_title">밖으로 보내나요?</string>
    <string name="a11y_consent_send">서울 지하철 환승 안내 때 화면에서 읽은 환승역 이름을 서울특별시 실시간 지하철 도착정보 API로 보냅니다(암호화되지 않은 HTTP). 그 밖에는 개발자 서버를 포함해 어디에도 보내지 않으며, 광고·분석 도구도 없습니다.</string>
    <string name="a11y_consent_decline_title">동의하지 않으면?</string>
    <string name="a11y_consent_decline">접근성을 켜지 않아도 앱을 쓸 수 있습니다. 지도 앱 알림으로 받는 안내는 그대로 나오고, 화면에서 읽는 안내(빠른 하차·환승 칸, 출발 안내, 최근 경로 등)는 나오지 않습니다. 켠 뒤에도 Android 설정 &gt; 접근성에서 언제든 끌 수 있습니다.</string>
    <string name="a11y_consent_agree">동의합니다</string>
    <string name="a11y_consent_disagree">동의하지 않습니다</string>
    <string name="a11y_consent_turn_off_title">접근성 기능이 켜져 있어요</string>
    <string name="a11y_consent_turn_off_desc">동의하지 않으셨으니 Android 설정 &gt; 접근성 &gt; 설치된 앱에서 「교통음성알림 구글 교통」·「교통음성알림 네이버 교통」을 꺼 주세요.</string>
    <string name="a11y_consent_turn_off_open">설정 열기</string>
    <string name="a11y_consent_turn_off_later">닫기</string>
    <string name="home_a11y_enable">접근성 기능 켜기</string>
    <string name="onboarding_allow">허용</string>
    <string name="onboarding_step_progress">%1$d / %2$d 단계</string>
    <string name="onboarding_naver_notify_title">네이버 알림 접근</string>
    <string name="onboarding_naver_notify_desc">네이버 버스 도착을 음성으로 알려 주려면 필요해요.\n아래 버튼을 누르면 나오는 화면에서 「교통음성알림」 스위치를 켜 주세요.</string>
    <string name="onboarding_notify_image_caption">이 스위치를 눌러 켜 주세요</string>
    <string name="onboarding_notify_image_desc">알림 접근 화면의 교통음성알림 스위치</string>
    <string name="onboarding_google_a11y_title">교통음성알림 구글 교통</string>
    <string name="onboarding_google_a11y_desc">구글 지도 안내를 음성으로 알려 주려면 필요해요.\n접근성에서 「설치된 앱」을 누르고, 「교통음성알림 구글 교통」을 켠 뒤 교통음성알림으로 돌아오세요.</string>
    <string name="onboarding_naver_subway_title">교통음성알림 네이버 교통</string>
    <string name="onboarding_naver_subway_desc">빠른 하차·환승 칸을 알려 주려면 필요해요.\n접근성에서 「설치된 앱」을 누르고, 「교통음성알림 네이버 교통」을 켠 뒤 교통음성알림으로 돌아오세요.</string>
